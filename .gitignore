# ============================================================
# ENVIRONMENT / SECRETS
# ============================================================

# Environment files
.env
.env.*
*.env

# Allow example environment files
!.env.example
!.env.template

# Local secret/config files
secrets/
secret/
*.secret

# Private keys / certificates
*.pem
*.key
*.p12
*.pfx
*.jks

# IMPORTANT:
# Do NOT commit real passwords, API keys, tokens,
# database credentials, JWT secrets, etc.


